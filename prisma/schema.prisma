// ─────────────────────────────────────────────────────────────────────────────
// UnitKu — Kelola Kost, Kontrakan & Unit Sewa Tanpa Ribet
// Prisma schema — PostgreSQL (Supabase) — wajib utk deployment Vercel serverless
//
// Nilai status/kategori mengikuti tipe TS di src/lib (kost-data.ts,
// kost-invoices.ts, ticket-data.ts, kost-cashflow.ts) dan disimpan sebagai
// String agar mudah dikembangkan antar versi tanpa migrasi enum.
// Field array memakai Json / tabel anak (aturan: tidak ada tipe list skalar).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Properti ─────────────────────────────────────────────────────────────────

model Property {
  id        String   @id // "kgp" untuk properti seed utama — cuid utk properti baru
  // Pemilik (SaaS multi-tenant) — user id dari Supabase Auth (auth.users.id)
  // pada mode Supabase, atau id OwnerAccount pada mode lokal/demo.
  // Null = data lama pra-multi-tenant (tidak terlihat oleh owner mana pun
  // sampai di-backfill — lihat panduan SQL di worklog/report).
  ownerId   String?
  name      String // "Kost Griya Pratama"
  tipe      String   @default("kost") // kost | kontrakan | unit-sewa
  alamat    String?
  fotoUrl   String?
  // Rekening pembayaran (Pengaturan → Rekening & Pembayaran → /api/properties)
  bankName        String? // "BCA"
  bankAccountNo   String? // "1234567890"
  bankAccountName String? // "Hendra Wijaya"
  // QRIS statis owner — dataURL gambar (PNG/JPG/WebP) + nama merchant / NMID
  // (Pengaturan → Rekening & Pembayaran → kartu QRIS; tampil di portal & pesan WA)
  qrisImageUrl    String?
  qrisNmid        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms      Room[]
  facilities Facility[]
  staffMembers StaffMember[]
  tickets      Ticket[]
  cashEntries  CashEntry[]
  technicianContacts TechnicianContact[]

  @@index([ownerId])
  @@map("properties")
}

// ── Akun Owner (HANYA mode auth lokal/demo — mode Supabase memakai auth.users)

model OwnerAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // scrypt "s1:salt:hash" (node:crypto)
  createdAt    DateTime @default(now())

  @@map("owner_accounts")
}

// ── Lisensi SaaS (jual putus — provisioning otomatis via webhook Mayar) ──────
// Status lisensi dipasang pada level AKUN (email), bukan properti — satu owner
// bisa punya beberapa properti, lisensi seumur hidup mengikuti akunnya.

model LicenseAccount {
  id                 String    @id @default(cuid())
  email              String    @unique // email owner — dinormalisasi lowercase
  // Id user di penyedia auth (Supabase auth.users.id / OwnerAccount.id lokal) —
  // terisi bila diketahui saat webhook memproses pembelian.
  userId             String?
  name               String?
  phone              String?
  isLifetimeLicensed Boolean   @default(false)
  paymentRef         String? // transaction id Mayar terakhir
  licensedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  purchases LicensePurchase[]

  @@map("license_accounts")
}

// ── Lead calon pembeli lisensi (data kontak form checkout / register) ────────
// Disimpan SEBELUM pembayaran — saat user klik "Bayar Otomatis" (sebelum
// redirect ke Mayar) maupun "Pesan Manual" (sebelum membuka WhatsApp), dan
// saat pendaftaran akun (/register). Satu baris per email (upsert) agar data
// kontak terbaru selalu siap di-follow-up admin dari Panel Super Admin.

model LicenseLead {
  id        String   @id @default(cuid())
  email     String   @unique // lowercase — kunci upsert
  name      String // Nama Lengkap dari form
  phone     String // Nomor WhatsApp ternormalisasi 62xxxxxxxxxx
  // Asal lead — BAYAR_OTOMATIS | PESAN_MANUAL | REGISTER
  source    String   @default("BAYAR_OTOMATIS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt]) // orderBy daftar lead di panel admin
  @@map("license_leads")
}

// Histori pembelian lisensi — transactionId unik menjadi kunci idempotensi
// webhook (event yang dikirim ulang Mayar tidak membuat baris/provisi ganda).

model LicensePurchase {
  id              String   @id @default(cuid())
  transactionId   String   @unique // id pembayaran Mayar
  email           String
  name            String?
  phone           String?
  amount          Int      @default(0) // nominal IDR
  status          String   @default("paid") // paid
  eventType       String? // event Mayar asli, mis. "payment.received"
  // Kanal asal lisensi — "MAYAR_WEBHOOK" (otomatis) | "MANUAL_SUPER_ADMIN"
  // (dibuat manual via panel /admin). Null = baris legacy sebelum kolom ada.
  provider        String?
  autoProvisioned Boolean  @default(false) // true = akun owner baru dibuat otomatis
  // Kredensial awal akun baru (plaintext sementara) — diserahkan manual ke
  // pembeli bila pengiriman email otomatis belum tersedia. Kosong utk akun lama.
  generatedPassword String?
  rawPayload      Json? // payload webhook asli (audit)
  licenseAccountId String?
  licenseAccount  LicenseAccount? @relation(fields: [licenseAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([email])
  @@map("license_purchases")
}

// ── Staf & Akses Mandiri (link undangan) ─────────────────────────────────────

model StaffMember {
  id          String   @id @default(cuid())
  propertyId  String? // properti penugasan — null = semua cabang
  name        String
  phone       String // display "+62 813-..."
  role        String   @default("PENJAGA_TEKNISI") // ADMIN_OPERASIONAL | PENJAGA_TEKNISI
  accessToken String   @unique // magic-link "stk_..." — /staff?token=...
  accessPin   String   @default("") // PIN keamanan 6 digit — verifikasi kedua di portal /staff
  isActive    Boolean  @default(true) // false = akses dicabut owner
  createdAt   DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([isActive])
  @@map("staff_members")
}

// ── Kamar / Unit ─────────────────────────────────────────────────────────────

model Room {
  id          String  @id // nomor/label alami kamar — "101", "A-01", "Paviliun Barat"
  propertyId  String
  floor       Int     @default(1)
  type        String  @default("") // "Tipe A - AC"
  price       Int     @default(0) // sewa per bulan (IDR)
  status      String  @default("kosong") // lunas | jatuhTempo | menunggak | kosong
  operational String? // renovasi | perbaikan (null = siap huni)

  // Kontrak sewa (opsional)
  contractDuration String? // Bulanan | Per 3 Bulan | Tahunan
  contractStart    DateTime?
  contractEnd      DateTime? // null = rolling (auto-renew bulanan)
  deposit          Int       @default(0)
  depositHeld      Boolean   @default(false)

  facilities Json? // string[] fasilitas milik kamar (JSONB)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant?
  invoices Invoice[]
  tickets  Ticket[]

  @@index([propertyId])
  @@index([status])
  @@map("rooms")
}

// ── Penghuni ─────────────────────────────────────────────────────────────────

model Tenant {
  id             String    @id @default(cuid())
  roomId         String    @unique // 1 kamar = 1 penghuni aktif
  name           String
  phone          String
  moveInAt       DateTime?
  emergencyName  String?
  emergencyPhone String?
  portalToken    String    @unique // magic-link Portal Penyewa — "tok_101_xxxxxx"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("tenants")
}

// ── Tagihan & Invoice ────────────────────────────────────────────────────────

model Invoice {
  id          String    @id // "#INV-202509-101"
  roomId      String
  tenantName  String? // null = kamar kosong (tagihan periode terakhir)
  tenantPhone String?
  roomType    String?
  periodLabel String // "1 Sep – 30 Sep 2025"
  periodKey   String // "2025-09"
  dueDate     DateTime?
  status      String    @default("jatuhTempo") // lunas | verifikasi | jatuhTempo | menunggak
  dayOffset   Int? // H+n = overdue, H-n = due in n days
  paidAt      DateTime?
  total       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room  Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lines InvoiceLine[]

  @@unique([roomId, periodKey])
  @@index([status])
  @@index([periodKey])
  @@map("invoices")
}

model InvoiceLine {
  id        Int    @id @default(autoincrement())
  invoiceId String
  label     String // "Sewa Kamar" | "Listrik" | "Parkir" | dst.
  amount    Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ── Fasilitas (katalog master per properti) ──────────────────────────────────

model Facility {
  id         String   @id // "fac_cctv-24-jam"
  propertyId String?
  group      String   @default("unit") // unit (milik kamar) | shared (bersama)
  label      String // "AC" | "CCTV 24 Jam"
  custom     Boolean  @default(false) // ditambahkan pengelola — dapat dihapus
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([group, label])
  @@map("facilities")
}

// ── Komplain & Pemeliharaan (tiket) ──────────────────────────────────────────

model Ticket {
  id            String   @id // "#TKT-041"
  roomId        String? // null = tiket fasilitas/area bersama
  lokasi        String? // "Area Parkir" — untuk tiket fasilitas
  sumber        String   @default("penyewa") // penyewa | fasilitas
  judul         String
  urgensi       String   @default("sedang") // rendah | sedang | darurat
  reporterName  String
  reporterPhone String   @default("")
  kategori      String   @default("Lainnya") // AC | Kelistrikan/Lampu | dst.
  deskripsi     String   @default("")
  photos        Json     @default("[]") // string[] URL/dataURL foto (JSONB)
  status        String   @default("menunggu") // menunggu | dikerjakan | selesai
  reportedLabel String // "Hari ini, 09:15 WIB"
  reportedSort  BigInt   @default(0) // sort monotonic yyyyMMddHHmm (terbaru dulu)
  teknisiName   String? // nama teknisi yang ditugaskan
  teknisiPhone  String? // kontak teknisi (link WA)
  selesaiLabel  String? // "Selesai 25 Sep, 10:30 WIB" — terisi saat status selesai
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  // Isolasi multi-tenant — tiket fasilitas (roomId null) terikat properti via kolom ini
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([roomId])
  @@index([propertyId])
  @@map("tickets")
}

// ── Kontak Teknisi (Komplain & Pemeliharaan) ─────────────────────────────────

model TechnicianContact {
  id            String   @id @default(cuid())
  name          String // "Pak Yanto"
  phone         String // "081322001177" / "+62 813-2200-1177" — wa.me dinormalisasi klien
  specialization String  @default("Tukang Bangunan/Umum") // "AC & Pendingin" | "Pipa & Sanitasi" | …
  isPrimary     Boolean  @default(false) // teknisi on-call utama — tampil di pill header
  // Isolasi multi-tenant — kontak teknisi milik satu properti
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
  @@map("technician_contacts")
}

// ── Buku Kas (pemasukan & pengeluaran) ───────────────────────────────────────

model CashEntry {
  id          String    @id // "KS-101"
  type        String    @default("masuk") // masuk | keluar
  category    String // Sewa Kamar | Listrik & Air (Fasilitas Umum / Pompa) | dst.
  description String    @default("")
  amount      Int       @default(0) // selalu positif; tanda berasal dari `type`
  source      String    @default("Kas Tunai") // sumber dana — "Kas Tunai" | "Transfer Rekening Bank"
  entryDate   DateTime?
  dateLabel   String // "01 Sep 2025"
  dateSort    Int       @default(0) // 20250901 — urutan terbaru dulu
  attachment  String? // bukti nota / bukti transfer (dataURL gambar atau referensi file)
  // Isolasi multi-tenant — transaksi kas milik satu properti
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([dateSort])
  @@index([propertyId])
  @@map("cash_entries")
}

// ── Pengaturan Owner (sinkron lintas perangkat — akun riil) ─────────────────
// Satu baris per owner (userId = auth.users.id / OwnerAccount.id). Menyimpan
// bagian Pengaturan yang sebelumnya HANYA di localStorage (hilang saat ganti
// perangkat / clear storage → tampil data dummy):
//   • owner          — Profil Saya { nama, email, whatsapp }
//   • propertyExtras — Profil Properti non-Property { lantai, jamMalam, aturan }
//   • properties     — daftar multi-cabang (settings)
//   • staff          — daftar staf versi settings
//   • templates      — template WhatsApp
//   • facilities     — katalog fasilitas
//   • theme          — tema tampilan
// Identitas properti (nama/tipe/alamat/fotoUrl) & rekening/QRIS TETAP di tabel
// "properties" (sumber kebenaran) — PUT /api/settings mencerminkannya ke sana.
model OwnerSetting {
  userId         String   @id
  owner          Json?
  propertyExtras Json?
  properties     Json?
  staff          Json?
  templates      Json?
  facilities     Json?
  theme          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("owner_settings")
}
