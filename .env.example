# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Runtime connection (transaction pooler / pgbouncer, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations / db push (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# ── Supabase project (public values — safe to expose to the client) ─────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# ── Mayar (jual putus — webhook & checkout lisensi seumur hidup) ─────────────
# Secret validasi webhook Mayar (header x-mayar-token / ?token=) — WAJIB di produksi
MAYAR_WEBHOOK_SECRET=""
# API key Mayar (KYC terverifikasi) — SERVER-SIDE ONLY, dipakai POST /api/checkout
MAYAR_API_KEY=""
# Base URL API Mayar (default https://api.mayar.id/hl/v1 — override hanya utk testing)
MAYAR_API_BASE_URL=""
# Service role key Supabase — SERVER-SIDE ONLY (provisioning akun via webhook)
SUPABASE_SERVICE_ROLE_KEY=""
# Tautan checkout Mayar lisensi seumur hidup (tombol CTA di layar gembok lisensi)
NEXT_PUBLIC_MAYAR_CHECKOUT_URL=""

# ── Landing komersial (KYC Mayar) ────────────────────────────────────────────
# Kontak Customer Care yang tampil di landing & halaman legal (GANTI sebelum produksi)
NEXT_PUBLIC_SUPPORT_WHATSAPP="6281000000000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@elvindigital.com"
# Label harga di landing — sinkronkan dengan produk Mayar, mis. "Rp399.000"
NEXT_PUBLIC_LICENSE_PRICE_LABEL="Rp399.000"
# Nominal lisensi (IDR, tanpa titik) yang dikirim ke API Mayar saat create invoice
NEXT_PUBLIC_LICENSE_PRICE_IDR="399000"

# ── Facebook Ads (Meta Pixel — halaman iklan /checkout) ──────────────────────
# ID Meta Pixel numeric, mis. "1234567890123456".
# Kosong = script pixel tidak dimuat sama sekali (tanpa error).
# Diisi = otomatis muat Meta Pixel + event 'PageView' & 'InitiateCheckout'.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""

# ── Panel Super Admin (/admin) ───────────────────────────────────────────────
# Email super admin (comma-separated, lowercase-normalized) — kosong = tidak ada
# yang punya akses panel. Contoh: "owner@elvindigital.com,admin@unitku.com"
SUPER_ADMIN_EMAILS=""
